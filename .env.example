# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_DB=ced_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
SERVER_PORT=3000

# ──────────────────────────────────────────────
# Spring Profile (leave empty for default)
# ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
JWT_SECRET=ReplaceThisWithA256BitSecretKeyMinimum32CharactersLongForHS256Signing
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
